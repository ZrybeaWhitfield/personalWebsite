<form
    class="form"
    name="contact"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
>
    <p class="hidden">
        <label>
            Don’t fill this out if you’re human: <input name="bot-field" />
        </label>
    </p>
    <p>
        <input placeholder="Name" type="text" name="name" minlength="2" />
    </p>
    <p>
        <!-- add regex pattern for validation here -->
        <input type="email" placeholder="Email" name="email" min="5" />
    </p>

    <p>
        <textarea
            placeholder="Message"
            name="message"
            minlength="10"></textarea>
    </p>
    <p>
        <button type="submit">Send Message</button>
    </p>
</form>
<style>
    .hidden {
        display: none;
    }
</style>
